<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
	<LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
	<!-- <NoWarn>$(NoWarn);CS1591</NoWarn> 	  If all members are not documented, you can disable the compiler warnings -->
	<NuGetAudit>true</NuGetAudit>
	<NuGetAuditMode>all</NuGetAuditMode>	  
  </PropertyGroup>

  <PropertyGroup>
	<EnablePackageValidation>true</EnablePackageValidation>
	<Authors>MNieto</Authors>
	<Title>EPlus multi-header report</Title>
	<Description>Extension for the EPPlus library to create reports from complex objects</Description>
	<PackageProjectUrl>https://github.com/mnieto/MultiHeader.EPPlus</PackageProjectUrl>
	<RepositoryUrl>https://github.com/mnieto/MultiHeader.EPPlus</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageTags>EPPlus;Excel;Multi-header;Report</PackageTags>
	<PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageIcon>EPlusMultiHeader.png</PackageIcon>
	<!-- Optional: Detect breaking changes from a previous version -->
	<!-- <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion> -->
  </PropertyGroup>	

  <ItemGroup>
	<PackageReference Include="DotNet.ReproducibleBuilds" Version="1.2.25">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="EPPlus" Version="8.5.4" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Kevull.MultiHeader.Core\Kevull.MultiHeader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
	<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
	  <_Parameter1>Kevull.MultiHeader.EPPLus.Tests</_Parameter1>
	</AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\EPlusMultiHeader.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
